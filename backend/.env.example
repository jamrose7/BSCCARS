# Application Port
PORT=3000

# Database Configuration (MySQL)
# Used for connecting to local development database
DB_HOST=localhost
DB_PORT=3306
DB_USER=bsccars_app
DB_PASSWORD=replace-with-bsccars-app-password
DB_NAME=bsccars

# Authentication Secret
# Used to sign JWT tokens for session authentication
# MUST be replaced with a strong random string in production
JWT_SECRET=replace-with-secure-random-string
JWT_EXPIRES_IN=8h

# Frontend URL used to build trusted email links. Do not rely on request Host.
APP_BASE_URL=http://localhost:3000

# SMTP Email
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=replace-with-smtp-user
SMTP_PASS=replace-with-smtp-password
MAIL_FROM_NAME=BSCCARS
MAIL_FROM_ADDRESS=replace-with-sender@example.com

EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
EMAIL_CHANGE_TOKEN_TTL_MINUTES=1440
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
ADMIN_ACTIVATION_TOKEN_TTL_MINUTES=1440
